{
  "expo": {
    "name": "voice-insclusive",
    "slug": "voice-insclusive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voiceinsclusive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Esta aplicación necesita acceso al micrófono para grabar notas de voz y realizar transcripciones."
      },
      "bundleIdentifier": "com.reikem.voiceinsclusive"
    },
    "android": {
      "package": "com.reikem.voiceinsclusive",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Permitir el acceso al micrófono para grabar audio en VoxInclusiva."
        }
      ]
    ]
  }
}
